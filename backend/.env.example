# Copia este archivo a ".env" y ajusta los valores.
# Para desarrollo local no hace falta tocar nada.

# Clave secreta para firmar los tokens (genera una larga, p.ej. con: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=

# Local: sqlite:///./sentinelx.db  |  Nube: postgresql://usuario:password@host:5432/db
DATABASE_URL=sqlite:///./sentinelx.db

# Orígenes permitidos en CORS, separados por coma (añade tu dominio Vercel en producción)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clave de la API de Groq (https://console.groq.com)
GROQ_API_KEY=

# Correo de avisos (opcional; solo se usa si SMTP_PASSWORD no está vacío)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_PASSWORD=
